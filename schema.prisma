// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "node_modules/.prisma/client"
}

model Message {
  id        String    @id @default(uuid()) @postgresql.Uuid
  name      String    @default("")
  email     String    @default("")
  message   String    @default("")
  createdAt DateTime? @default(now())
}

model NewsletterSubscription {
  id        String    @id @default(uuid()) @postgresql.Uuid
  name      String    @default("")
  email     String    @default("")
  createdAt DateTime? @default(now())
}

model User {
  id          String     @id @default(uuid()) @postgresql.Uuid
  firstname   String     @default("")
  lastname    String     @default("")
  picture     Json?      @default("{}")
  auth0Avatar String     @default("")
  email       String     @default("")
  authId      String     @unique @default("")
  gender      String?
  role        String     @default("reader")
  posts       Post[]     @relation("Post_author")
  comments    Comment[]  @relation("Comment_author")
  reactions   Reaction[] @relation("Reaction_author")
  createdAt   DateTime?  @default(now())
  updatedAt   DateTime?
}

model Post {
  id        String     @id @default(uuid()) @postgresql.Uuid
  metadata  Json?      @default("{}")
  cover     Json?      @default("{}")
  content   Json?      @default("{}")
  published Boolean    @default(true)
  tags      Tag[]      @relation("Tag_posts")
  author    User?      @relation("Post_author", fields: [authorId], references: [id])
  authorId  String?    @map("author") @postgresql.Uuid
  comments  Comment[]  @relation("Comment_post")
  reactions Reaction[] @relation("Reaction_post")
  createdAt DateTime?  @default(now())
  updatedAt DateTime?

  @@index([authorId])
}

model Tag {
  id        String    @id @default(uuid()) @postgresql.Uuid
  label     String    @default("")
  posts     Post?     @relation("Tag_posts", fields: [postsId], references: [id])
  postsId   String?   @map("posts") @postgresql.Uuid
  createdAt DateTime? @default(now())

  @@index([postsId])
}

model Comment {
  id        String     @id @default(uuid()) @postgresql.Uuid
  content   Json?      @default("{}")
  author    User?      @relation("Comment_author", fields: [authorId], references: [id])
  authorId  String?    @map("author") @postgresql.Uuid
  post      Post?      @relation("Comment_post", fields: [postId], references: [id])
  postId    String?    @map("post") @postgresql.Uuid
  parent    Comment?   @relation("Comment_parent", fields: [parentId], references: [id])
  parentId  String?    @map("parent") @postgresql.Uuid
  comments  Comment[]  @relation("Comment_parent")
  reactions Reaction[] @relation("Reaction_comment")
  createdAt DateTime?  @default(now())
  updatedAt DateTime?

  @@index([authorId])
  @@index([postId])
  @@index([parentId])
}

model Reaction {
  id        String    @id @default(uuid()) @postgresql.Uuid
  type      String?
  post      Post?     @relation("Reaction_post", fields: [postId], references: [id])
  postId    String?   @map("post") @postgresql.Uuid
  comment   Comment?  @relation("Reaction_comment", fields: [commentId], references: [id])
  commentId String?   @map("comment") @postgresql.Uuid
  author    User?     @relation("Reaction_author", fields: [authorId], references: [id])
  authorId  String?   @map("author") @postgresql.Uuid
  createdAt DateTime? @default(now())

  @@index([postId])
  @@index([commentId])
  @@index([authorId])
}
